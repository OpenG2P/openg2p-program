<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_module_filter_inherit_program" model="ir.ui.view">
        <field name="name">ir.module.module.search.g2p.programs</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="g2p_registry_app_filter.view_module_filter_inherit_g2p" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='app']" position="attributes">
                <attribute
                    name="domain"
                >[('application', '=', True), '|', ('name', '=', 'g2p_registry'), ('name', '=', 'g2p_programs_all')]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
